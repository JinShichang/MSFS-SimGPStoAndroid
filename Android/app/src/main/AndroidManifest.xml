<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:versionCode="5502"
    android:versionName="5.5.2">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- 摄像头权限 -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- 前台服务（连接电脑 + 模拟定位，保证后台运行） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- Android 13+ 通知权限（前台服务通知显示需要） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 后台持续工作需要的锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- 悬浮窗（显示在其他应用上层） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- 电池优化白名单申请 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- 模拟定位权限：由系统在开发者选项"选择模拟位置信息应用"中授予 -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions"/>

    <!-- 摄像头特性声明，可选设备不强制要求 -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MSFSSimConnect">

        <service
            android:name=".MockLocationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="模拟定位：将 MSFS 电脑端位置注入系统，供其他地图应用导航使用"/>
        </service>

        <activity android:name=".ScanActivity" />
        <activity android:name=".scanP" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>

</manifest>
